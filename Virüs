import logging
import os
import sys

logging.basicConfig(
    level=logging.INFO,
    format="%(levelname)s: %(message)s",
)
logger = logging.getLogger(__name__)

deleted_count = 0
skipped_count = 0
failed_items = []

try:
    files = os.listdir(".")
except OSError as e:
    logger.critical("Klasör okunamadı / Could not read directory: %s", e)
    sys.exit(1)

for f in files:
    if f.endswith(".py"):
        continue

    try:
        os.remove(f)
        deleted_count += 1
        logger.info("%s silindi / deleted", f)
    except IsADirectoryError:
        skipped_count += 1
        logger.warning("%s bir klasör, atlandı / is a directory, skipped", f)
    except PermissionError as e:
        failed_items.append((f, e))
        logger.error("%s izin hatası / permission denied: %s", f, e)
    except OSError as e:
        failed_items.append((f, e))
        logger.error("%s silinemedi / could not delete: %s", f, e)

logger.info(
    "Özet / Summary: %d silindi / deleted, %d atlandı / skipped, %d başarısız / failed",
    deleted_count,
    skipped_count,
    len(failed_items),
)

if failed_items:
    logger.error("Başarısız öğeler / Failed items:")
    for name, err in failed_items:
        logger.error("  %s: %s", name, err)
    sys.exit(1)

logger.info("İşlem tamamlandı! / Operation complete!")
